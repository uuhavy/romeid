# Target Rome chain resolved dynamically via @rome-protocol/registry (200010 = Hadrian testnet, 7531 = Rubicon mainnet)
CHAIN_ID=200010
PROXY_URL=
SOLANA_RPC=

# EVM lane deployer/signer private key (0x-prefixed 32-byte hex).
# Fund >= 0.5 USDC (recommended 1 USDC) on Hadrian via `rome fund hadrian --from sepolia --amount 1` before deploying.
PRIVATE_KEY=
ROME_EVM_KEY=

# Optional second EVM key (employer/attester) for headless end-to-end testing
ATTESTER_EVM_KEY=

# Solana lane keypair (64-byte JSON array from solana-keygen) for `rome verify` & headless dual-lane tests
# Fund >= 0.02 devnet SOL for rent/tx fees
ROME_SOLANA_KEY=

# Populated automatically by scripts/deploy.ts (never hardcoded in source code)
IDENTITY_REGISTRY_ADDRESS=
WORK_REGISTRY_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=
